# ============================================
# CONFIGURAÇÃO DO BANCO DE DADOS
# ============================================
# Escolha o motor do banco de dados
# Opções: "postgresql" ou "sqlite"
DB_ENGINE=postgresql

# ============================================
# POSTGRESQL - Preencha se DB_ENGINE=postgresql
# ============================================
# Usuário do banco de dados PostgreSQL
DB_USER=postgres

# Senha do usuário PostgreSQL
DB_PASSWORD=senha

# Servidor onde PostgreSQL está rodando
# localhost = sua máquina local
# Exemplo remoto: db.exemplo.com.br
DB_HOST=localhost

# Porta padrão do PostgreSQL é 5432
DB_PORT=5432

# Nome do banco de dados que será criado/utilizado
DB_NAME=sistema_chamados

# ============================================
# SQLITE - Preencha se DB_ENGINE=sqlite
# ============================================
# Caminho do arquivo SQLite (apenas para desenvolvimento)
# Exemplo: ./data/sistema_chamados.db
# DB_PATH=sistema_chamados.db

# ============================================
# INSTRUÇÕES
# ============================================
# 1. Faça uma cópia deste arquivo: cp .env.example .env
# 2. Preencha os dados de acordo com seu banco de dados
# 3. NUNCA commite .env no git (já está no .gitignore)
# 4. Cada desenvolvedor tem seu próprio .env com suas credenciais
